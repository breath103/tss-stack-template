{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.react.json"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "./src/global.css"
    }
  },
  "rules": {
    "local/no-double-cast": "error",
    "local/no-class-scoped-module-const": "error",
    "local/no-manual-date-format": "error",
    "local/no-entities-index": "error",
    "local/no-native-date-input": "error",
    "local/no-template-literal-classname": "error",
    "local/no-inline-font-size": "error",
    "local/no-raw-fetch": "error",
    "local/no-raw-text-input": "error",
    "local/no-create-route-outside-route-file": "error",

    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@backend",
            "message": "Use 'import type' for @backend imports. Runtime imports from backend are not allowed in frontend.",
            "allowTypeImports": true
          }
        ],
        "patterns": [
          {
            "regex": "^@backend/",
            "message": "Use 'import type' for @backend imports. Runtime imports from backend are not allowed in frontend.",
            "allowTypeImports": true
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/**"],
      "rules": {
        "local/no-i18n-prop": "error"
      }
    },
    {
      "files": ["src/lib/**"],
      "rules": {
        "local/no-hand-written-event-guard": "error"
      }
    },
    {
      "files": ["src/lib/api-client.ts"],
      "rules": {
        "local/no-raw-fetch": "off"
      }
    },
    {
      // Stays local rather than in a shared tier: `no-double-cast` is enabled by
      // this config's own `rules`, so only an override in this file lands after it.
      "files": ["**/__tests__/**"],
      "rules": {
        "local/no-double-cast": "off"
      }
    }
  ]
}
