{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "ignorePatterns": ["src/types/database.generated.ts"],
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "local/no-http-exception-message": "error"
      }
    },
    {
      "files": ["src/lib/**", "src/types/**"],
      "rules": {
        "local/no-hand-written-event-guard": "error"
      }
    },
    {
      // The overlay that DEFINES the row types the rule points everyone else at.
      "files": ["src/types/database.ts"],
      "rules": {
        "local/no-inline-database-row-type": "off"
      }
    }
  ]
}
