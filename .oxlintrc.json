{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.base.json"],
  // The Node/server tier: everything that ships to a Lambda or runs as tooling.
  // Root `scripts/` and `e2e/` pick this up by proximity.
  //
  // `no-lodash-es` is deliberately NOT in `.oxlintrc.react.json`: Node ESM cannot
  // tree-shake the barrel, while Vite can, and the split packages make a bundle worse.
  "rules": {
    "local/no-lodash-es": "error"
  },
  "overrides": [
    {
      // `**/src/**`, not `src/**`: this config sits at the repo root, where a
      // root-relative `src/**` would match nothing.
      "files": ["**/src/**/*.ts"],
      "rules": {
        "local/no-extraneous-dependencies": "error",
        "local/no-as-error": "error",
        "local/no-double-cast": "error",
        "local/no-class-scoped-module-const": "error",
        "local/no-process-env-bang": "error",
        "local/no-select-star": "error",
        "local/no-inline-database-row-type": "error",
        "local/no-manual-calendar-date": "error"
      }
    },
    {
      // MUST stay after the block above: overrides apply in order, so listing this
      // first (or in `.oxlintrc.base.json`) lets `**/src/**` re-enable these for tests.
      // Both test conventions are in use: `__tests__/` dirs and colocated `*.test.ts`.
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "local/no-extraneous-dependencies": "off",
        "local/no-manual-calendar-date": "off"
      }
    }
  ]
}
