{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"$CLAUDE_PROJECT_DIR\"/node_modules/.cache/hook_bash_policy \"$CLAUDE_PROJECT_DIR\"/scripts/hook_bash_policy.mts",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
