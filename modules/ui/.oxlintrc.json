{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.react.json"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "./src/theme/reference.css"
    }
  },
  // Deliberately NOT in `.oxlintrc.react.json`, so it does not reach `packages/frontend`.
  // The library ships a neutral type scale that consumers reskin by overriding tokens,
  // so an arbitrary `text-[…]` here is unthemeable; an app owns its own scale.
  "rules": {
    "tailwindcss/no-restricted-classes": [
      "error",
      {
        "patterns": [
          {
            "pattern": "text-\\[[^\\]]+\\]",
            "message": "No arbitrary text-[…] values — use the type-scale / color tokens."
          }
        ]
      }
    ]
  }
}
